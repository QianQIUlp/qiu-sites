{
  "name": "qiu-sites",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "dev:developer": "npm --prefix developer run dev",
    "build": "astro build",
    "build:developer": "npm --prefix developer run build",
    "build:all": "npm run build && npm run build:developer",
    "preview": "astro preview --host 0.0.0.0",
    "preview:developer": "npm --prefix developer run preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "astro": "^7.1.0"
  }
}
