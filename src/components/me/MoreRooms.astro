---
import type { Lang } from '../../i18n';
import Icon from './Icon.astro';
import workPreview from '../../assets/me/work-home.webp';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
// hand-font:start
const idleNote = t('你不动，它才走。', 'It only moves when you don’t.');
// hand-font:end
const clockTicks = Array.from({ length: 12 }, (_, i) => i * 30);
---
<section class="place paths" data-scene="paths" aria-labelledby="paths-title" inert>
  <div class="place-heading">
    <span class="eyebrow">{t('未走之路 / SAME END. DIFFERENT WAY.', 'SAME END. DIFFERENT WAY.')}</span>
    <h2 id="paths-title"><Fragment set:html={t('如果结局一样，<br><em>还要选择吗。</em>', 'The same ending.<br><em>Still your choice.</em>')} /></h2>
    <p><Fragment set:html={t('两端固定。中间留给你。<br>拨开这束线，给今天换一种走法。', 'Two fixed ends. The middle is yours.<br>Part these threads. Take another way.')} /></p>
  </div>
  <div class="path-choices" data-room-control role="group" aria-label={t('选择这一次的路径', 'Choose a route')}>
    <button data-route="0" aria-pressed="true"><span>01</span> {t('穿过去', 'Through')} <i><Icon name="northeast" /></i></button>
    <button data-route="1" aria-pressed="false"><span>02</span> {t('绕一段', 'Around')} <i><Icon name="wave" /></i></button>
    <button data-route="2" aria-pressed="false"><span>03</span> {t('停一下', 'A pause')} <i><Icon name="point" /></i></button>
  </div>
  <div class="path-instrument" data-room-control tabindex="0" role="group" aria-label={t('拖动线束改变路径，或用左右方向键调节', 'Drag the threads or use the left and right arrow keys to bend the path')}>
    <canvas id="path-field" aria-hidden="true"></canvas>
    <span class="field-index">08 / A SMALL DEVIATION</span>
    <span class="field-axis"><Fragment set:html={t('起点、终点不变。<br>经过的此刻不同。', 'The same two ends.<br>A different moment between.')} /></span>
    <div class="path-listen"><button id="path-play" type="button" aria-label={t('听这条路', 'Listen to this path')}><span class="route-play-icon"><Icon name="play" /></span><span id="path-play-label">{t('听这条路', 'Listen to this path')}</span></button><span id="path-measure">{t('01 / 穿过去', '01 / Through')}</span></div>
  </div>
  <div class="path-thought" aria-live="polite"><span id="path-status">{t('还没有走过的路，都在这里。', 'The paths you haven’t taken are still here.')}</span><blockquote><Fragment set:html={t('「至少我今天认真地活过一回，<br>这就够了。」', '“At least today, I lived with intention.<br>That’s enough.”')} /></blockquote></div>
  <label class="path-tension" data-room-control><span>{t('拨开一点', 'Bend it')}</span><input id="path-bend" type="range" min="-100" max="100" value="0" step="1" aria-label={t('路径的偏移', 'Bend the path')}><span><Icon name="horizontal" /></span></label>
  <div class="extra-footer"><a href="/blog/posts/2026-05-17-qiyuniao/" target="_blank" rel="noopener noreferrer">{t('从《启喻鸟之章》的一个问题出发', 'From a question about fate · Read in Chinese')} <Icon name="northeast" /></a><button data-place="trace">{t('把走过的，留成一笔', 'Leave a line of your own')} <span><Icon name="right" /></span></button></div>
</section>

<section class="place blindspot" data-scene="blindspot" aria-labelledby="blindspot-title" inert>
  <div class="place-heading">
    <span class="eyebrow">{t('盲点 / CERTAINTY HAS A VIEWPOINT', 'CERTAINTY HAS A VIEWPOINT')}</span>
    <h2 id="blindspot-title"><Fragment set:html={t('太完整的答案，<br><em>也许藏着裂缝。</em>', 'A perfect answer.<br><em>Look for the gaps.</em>')} /></h2>
    <p><Fragment set:html={t('眼前的「确定」，只在一个角度成立。<br>拖动它，看看原先看不见的部分。', '确定 means “certainty”. It fits from one angle.<br>Turn it to see what that view conceals.')} /></p>
  </div>
  <div class="blind-caption" aria-live="polite"><span id="blind-index">{t('01 / 正面', '01 / THE FRONT')}</span><h3 id="blind-caption-title">{t('看起来，严丝合缝。', 'It all seems to fit.')}</h3><p id="blind-caption-copy">{t('那篇关于 AI 的笔记写到第八节，我开始拆掉前面自己的论证。', 'By section eight of my essay on AI, I was taking apart my own argument.')}</p></div>
  <div class="blind-instrument" data-room-control tabindex="0" role="group" aria-label={t('拖动观看错位文字，或用左右方向键改变角度', 'Drag the fragmented word or use the left and right arrow keys to change your viewpoint')}>
    <canvas id="blind-field" aria-hidden="true"></canvas>
    <span class="field-index">09 / AN INCOMPLETE CERTAINTY</span><span class="blind-bearing"><output id="blind-degrees" for="blind-angle">00°</output><span>VIEWPOINT</span></span>
    <span class="blind-guide">{t('文字没有消失。只是终于看见了间隙。', 'The word is still here. Now you can see its gaps.')}</span>
  </div>
  <div class="blind-controls" data-room-control><button id="blind-turn" class="small-action" type="button">{t('换个角度', 'Another angle')} <span><Icon name="northeast" /></span></button><label><span>{t('正面', 'Front')}</span><input id="blind-angle" type="range" min="0" max="60" value="0" step="1" aria-label={t('观看确定的角度', 'Viewpoint on certainty')}><span>{t('侧面', 'Side')}</span></label></div>
  <div class="extra-footer"><a href="/blog/posts/2026-05-26-llm-metacog-blindspot/#八写到这里给自己泼一盆冷水" target="_blank" rel="noopener noreferrer">{t('看《LLM 元认知盲点》里留下的自我修正', 'Read my correction · In Chinese')} <Icon name="northeast" /></a><button data-place="rethink">{t('也去翻翻另一面', 'Turn a thought over, too')} <span><Icon name="southwest" /></span></button></div>
</section>

<section class="place rethink" data-scene="rethink" aria-labelledby="rethink-title" inert>
  <div class="place-heading">
    <span class="eyebrow">{t('另一面 / A THOUGHT, TURNED OVER', 'A THOUGHT, TURNED OVER')}</span>
    <h2 id="rethink-title"><Fragment set:html={t('翻过来，<br><em>还是我。</em>', 'Turn it over.<br><em>Still me.</em>')} /></h2>
    <p><Fragment set:html={t('有些判断，走到背面，<br>才发现它和自己连在一起。', 'Follow a thought to its other side.<br>You might find yourself there.')} /></p>
  </div>
  <div class="mobius-stage" data-room-control tabindex="0" role="group" aria-label={t('拖动纸带或使用下方滑杆，翻看判断的另一面', 'Drag the ribbon, use the arrow keys or the slider to turn a thought over')}>
    <canvas id="mobius" aria-hidden="true"></canvas>
    <span class="ribbon-registration registration-a"><Icon name="plus" /></span><span class="ribbon-registration registration-b"><Icon name="plus" /></span>
    <span class="ribbon-side-note">ONE SURFACE. NO FINAL SIDE.</span>
    <span class="ribbon-drag-hint">{t('拖动纸带', 'Turn the ribbon')} <Icon name="horizontal" /></span>
  </div>
  <div class="thought-caption" aria-live="polite">
    <span id="thought-kicker">{t('起初，我以为', 'At first, I thought')}</span>
    <blockquote id="thought-quote">{t('「有条件的善意不是善意，是定价。」', '“Conditional kindness isn’t kindness. It’s a price.”')}</blockquote>
    <p id="thought-after">{t('好记、锋利、适合转发。问题是它错了，至少是偷懒。', 'Sharp. Catchy. Easy to share. The trouble is, it was wrong. Or at least, lazy.')}</p>
  </div>
  <div class="ribbon-controls" data-room-control>
    <button id="turn-thought" class="small-action">{t('再翻一面', 'Turn it again')} <Icon name="replay" /></button>
    <label><span>{t('看见别人', 'Look out')}</span><input id="thought-angle" type="range" min="0" max="360" value="0" aria-label={t('翻转观点纸带', 'Turn the ribbon')}><span>{t('看回自己', 'Look in')}</span></label>
  </div>
  <div class="extra-footer"><a href="/blog/posts/2026-05-29-liar-game-role-game/" target="_blank" rel="noopener noreferrer">{t('从《世界不是 liar game，是 role game》里长出来', 'From my essay on roles · Read in Chinese')} <Icon name="northeast" /></a><button data-place="work">{t('去看看，想法怎么变成东西', 'See a thought become a thing')} <span><Icon name="right" /></span></button></div>
</section>

<section class="place work" data-scene="work" aria-labelledby="work-title" inert>
  <div class="place-heading"><span class="eyebrow">{t('拆开看看 / BENEATH THE SURFACE', 'BENEATH THE SURFACE')}</span><h2 id="work-title"><Fragment set:html={t('表面之下，<br><em>还有做法。</em>', 'Under the surface,<br><em>decisions.</em>')} /></h2><p><Fragment set:html={t('移动这道光。<br>让作品的做法与边界，显出截面。', 'Move this light.<br>Reveal the decisions and limits within.')} /></p></div>
  <div class="project-picker" role="group" aria-label={t('选一件作品', 'Choose a project')} data-room-control>
    <button data-project="verisilo" aria-pressed="true"><i></i>VeriSilo</button>
    <button data-project="meal" aria-pressed="false"><i></i>MealCircuit</button>
    <button data-project="crew" aria-pressed="false"><i></i>Crewlight</button>
    <button data-project="hadoop" aria-pressed="false"><i></i>Hadoop Lab</button>
  </div>
  <div class="work-sculpture" data-room-control tabindex="0" role="group" aria-label={t('上下拖动光的切面，观察作品内部；方向键也可调节', 'Drag up and down or use the arrow keys to move the section through the project')} data-unavailable={t('切面预览暂不可用，仍可用下方滑杆阅读作品。', 'The 3D preview is unavailable. Use the slider below to explore the project.')}>
    <div class="specimen-register">
      <span><i></i><span id="surface-name">VeriSilo</span> / <span id="specimen-index">01</span></span>
      <button id="work-play" type="button" aria-label={t('播放完整演示', 'Play the full tour')} aria-controls="work-specimen work-spread work-detail-copy" aria-pressed="false">
        <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="play-rail" cx="18" cy="18" r="16"/><circle class="play-progress" cx="18" cy="18" r="16" pathLength="100"/><path id="work-play-icon" d="M15 11.5 25 18 15 24.5Z"/></svg>
        <span><span id="work-play-label">{t('完整演示', 'Full tour')}</span><small id="work-play-step" role="status">{t('起因 · 做法 · 边界', 'Why · How · Limits')}</small></span>
      </button>
    </div>
    <img class="work-preview" src={workPreview.src} width={workPreview.width} height={workPreview.height} alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low">
    <canvas id="work-specimen" aria-hidden="true"></canvas>
    <span class="specimen-cross specimen-cross-a" aria-hidden="true"><Icon name="plus" /></span><span class="specimen-cross specimen-cross-b" aria-hidden="true"><Icon name="plus" /></span>
    <div class="specimen-notation" aria-hidden="true"><span id="specimen-figure">FIG. 01 — SEPARATE BY DESIGN</span><span id="cut-reading">042</span></div>
    <div class="specimen-caption"><span id="specimen-principle">{t('先有边界，再有各自的空间。', 'Separate spaces begin with boundaries.')}</span><span class="work-drag-hint">{t('上下拖动 · 让光穿过', 'Drag to move the light')} <Icon name="vertical" /></span></div>
  </div>
  <div class="work-detail" aria-live="polite"><span class="work-detail-label" id="work-detail-label">{t('它从一个问题开始', 'It starts with a question')}</span><p id="work-detail-copy">{t('多个网站身份，为什么要挤在同一个浏览器环境里？', 'Why should different online identities share a single browser environment?')}</p><a id="project-source" href="https://github.com/QianQIUlp/VeriSilo" target="_blank" rel="noopener noreferrer">{t('看真实项目', 'Explore the project')} <Icon name="northeast" /></a></div>
  <div class="work-controls" data-room-control>
    <div class="cut-control"><span class="cut-start">{t('表面', 'Surface')}</span><input id="work-spread" type="range" min="0" max="100" step="0.1" value="42" aria-label={t('光的切入深度', 'Section depth')}><span class="cut-end">{t('深处', 'Inside')}</span></div>
    <div class="work-depths"><button data-depth="0" aria-pressed="false"><span>01</span> {t('起因', 'Why')}</button><button data-depth="50" aria-pressed="true"><span>02</span> {t('做法', 'How')}</button><button data-depth="100" aria-pressed="false"><span>03</span> {t('边界', 'Limits')}</button></div>
  </div>
  <div class="extra-footer"><a href={lang === 'en' ? 'https://qiu.works/' : 'https://qiu.works/zh/'} target="_blank" rel="noopener noreferrer">{t('去 Q Studio，继续看作品', 'More at Q Studio')} <Icon name="northeast" /></a><button data-place="idle">{t('也可以，什么都不做', 'Or do nothing for a while')} <span><Icon name="right" /></span></button></div>
</section>

<section class="place idle" data-scene="idle" aria-labelledby="idle-title" inert>
  <div class="idle-sun" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="place-heading"><span class="eyebrow">{t('不赶时间 / AN UNPRODUCTIVE CORNER', 'AN UNPRODUCTIVE CORNER')}</span><h2 id="idle-title"><Fragment set:html={t('这里，<br><em>不用有用。</em>', 'Here,<br><em>nothing is due.</em>')} /></h2><p><Fragment set:html={t('把几个「应该」放进去。<br>拖过去，或者点一下纸片。', 'Let go of a few “shoulds”.<br>Drag a slip into the hollow. Or tap it.')} /></p></div>
  <div class="idle-void" aria-hidden="true"><span class="idle-outline" lang="zh-Hans">空</span><div class="paper-hole"><div class="hole-rim"></div><div class="hole-bottom"><span>{t('也没关系。', 'That’s okay.')}</span></div></div><span class="hole-cross"><Icon name="plus" /></span></div>
  <canvas class="idle-dust" aria-hidden="true"></canvas>
  <div class="idle-clock" aria-hidden="true"><svg viewBox="-50 -50 100 100"><circle class="clock-face" r="46" />{clockTicks.map(angle => <line class="clock-tick" class:list={{ major: angle % 90 === 0 }} x1="0" y1={angle % 90 === 0 ? -40 : -42} x2="0" y2="-45" transform={`rotate(${angle})`} />)}<line class="clock-hour" x1="0" y1="5" x2="0" y2="-24" /><line class="clock-minute" x1="0" y1="7" x2="0" y2="-36" /><circle class="clock-pin" r="2.2" /></svg></div>
  <p class="pencil-note note-idle" data-note="idle-still" aria-hidden="true"><svg viewBox="0 0 48 30"><path pathLength="1" d="M3 25C14 24 28 19 40 8M40 8l-7.6 1.3M40 8l-1.2 7.4" /></svg><span>{idleNote}</span></p>
  <div class="idle-lamp" aria-hidden="true"><i class="lamp-cord"></i><svg class="lamp-shade" viewBox="0 0 80 64"><path class="lamp-cap" d="M36 0h8v9h-8Z" /><path class="lamp-body" d="M13 50C13 27 25 9 40 9s27 18 27 41Z" /><path class="lamp-inside" d="M13 50C22 57 58 57 67 50C58 46 22 46 13 50Z" /><circle class="lamp-bulb" cx="40" cy="53" r="6.5" /></svg><i class="lamp-pool"></i></div>
  <div class="obligation-slips" data-room-control>
    <button class="obligation obligation-a" data-slip="0" aria-label={t('放下用完额度的催促', 'Let go of the need to use up your quota')}><span class="slip-kicker">{t('应该', 'I SHOULD')}</span><strong><Fragment set:html={t('把额度<br>用完。', 'Use it<br>all up.')} /></strong><span class="slip-foot">{t('放下', 'Let go')} <Icon name="southeast" /></span></button>
    <button class="obligation obligation-b" data-slip="1" aria-label={t('放下让订阅回本的催促', 'Let go of the need to earn back your subscription')}><span class="slip-kicker">{t('应该', 'I SHOULD')}</span><strong><Fragment set:html={t('把订阅<br>补回来。', 'Make it<br>pay off.')} /></strong><span class="slip-foot">{t('放下', 'Let go')} <Icon name="southwest" /></span></button>
    <button class="obligation obligation-c" data-slip="2" aria-label={t('放下不能过期的催促', 'Let go of the need to use it before it expires')}><span class="slip-kicker">{t('应该', 'I SHOULD')}</span><strong><Fragment set:html={t('别让它<br>过期。', 'Beat the<br>deadline.')} /></strong><span class="slip-foot">{t('放下', 'Let go')} <Icon name="northeast" /></span></button>
    <button class="obligation obligation-d" data-slip="3" aria-label={t('放下总要做点什么的催促', 'Let go of the need to always do something')}><span class="slip-kicker">{t('应该', 'I SHOULD')}</span><strong><Fragment set:html={t('总得做点<br>什么。', 'Do<br>something.')} /></strong><span class="slip-foot">{t('放下', 'Let go')} <Icon name="northwest" /></span></button>
  </div>
  <div class="idle-sentence" aria-live="polite"><span id="idle-preface">{t('我不欠资源一次使用。', 'I don’t owe a resource a use.')}</span><p id="idle-message"><Fragment set:html={t('留白，<br><em>也可以留下来。</em>', 'Leave room<br><em>for nothing.</em>')} /></p></div>
  <div class="idle-sentence idle-dusk" aria-live="polite"><span></span><p></p></div>
  <button id="restore-slips" class="small-action">{t('把纸片摆回来', 'Bring the slips back')} <Icon name="restore" /></button>
  <div class="extra-footer"><a href="/blog/posts/2026-06-18-resource-usage-rule/" target="_blank" rel="noopener noreferrer">{t('这处留白，来自《我不欠资源一次使用》', 'On leaving things unused · Read in Chinese')} <Icon name="northeast" /></a><button data-place="home">{t('回到吉他旁边', 'Back to the guitar')} <span><Icon name="northeast" /></span></button></div>
</section>
