---
import type { Lang } from '../../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
import { localizedPath } from '../../i18n';
import Pedalboard from './Pedalboard.astro';
import MoreRooms from './MoreRooms.astro';
import guitarPhoto from '../../assets/me/bangdream-potbelly-fm-rana.webp';
import guitarPreview from '../../assets/me/guitar-home.webp';
import jamStrings from '../../assets/me/jam-strings.webp';
const mapPlaces = [
  ['home', '中央', 'Home', '回到中央', 'Back home'],
  ['papers', '散页', 'Pages', '去散页', 'Go to loose pages'],
  ['music', '琴弦', 'Strings', '去琴弦之间', 'Go to a little jam'],
  ['trace', '留一笔', 'A line', '去留一笔', 'Go to leave a line'],
  ['rethink', '另一面', 'Other side', '去另一面', 'Go to the other side'],
  ['work', '拆开看看', 'Inside', '去拆开看看', 'Go beneath the surface'],
  ['idle', '不赶时间', 'No hurry', '去不赶时间', 'Go to no hurry'],
  ['paths', '未走之路', 'Paths', '去未走之路', 'Go to paths untaken'],
  ['blindspot', '盲点', 'Blind spots', '去盲点', 'Go to blind spots'],
];
---
<a class="skip-link" href="#room">{t("跳到小屋", "Skip to the room")}</a>
<header class="masthead"><button class="signature" data-place="home" aria-label={t("回到小屋中央", "Back to the room")}><b>Q<span>i</span>u</b><span class="signature-cross"><Icon name="plus" /></span></button><p>{t("千秋的私人一隅", "Qiu, between notes.")}<span>ME.QIU.WORKS</span></p><div class="header-actions"><nav class="language-switch" aria-label={t('语言', 'Language')}>
        <a href="/" lang="zh-CN" hreflang="zh-CN" aria-current={lang === 'zh' ? 'page' : undefined}>中</a>
        <a href="/en/" lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </nav><button class="audio-toggle" type="button" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8v4h3l4 3V5L6 8H3Zm11-1v6m3-9v12"/></svg><span>{t("声音关", "Sound off")}</span></button><a href="https://qiu.works" target="_blank" rel="noopener noreferrer">QStudio <span><Icon name="northeast" /></span></a></div></header>
  <main id="room" tabindex="-1" aria-label={t("可拖动、缩放的小屋。可通过下方地图选择去处。", "A room you can drag and explore. Use the map below to choose a place.")}>
    <canvas id="instrument" aria-hidden="true"></canvas>
    <div class="world" id="world">
      <section class="place home" data-scene="home" aria-label={t("小屋中央", "At home")}>
        <div class="home-meta"><span>{t("我是千秋。欢迎来坐坐。", "I’m Qiu. Make yourself at home.")}</span><span>{t("六根弦，以及它们以外的事。", "Six strings, and whatever comes to mind.")}</span></div>
        <h1 class="name" lang="zh-Hans" aria-label="千秋"><span>千</span><span>秋</span></h1>
        <img class="home-guitar-preview" src={guitarPreview.src} width={guitarPreview.width} height={guitarPreview.height} alt="" aria-hidden="true" fetchpriority="high" decoding="async" draggable="false">
        <button class="guitar-touch" data-open-guitar aria-label={t("拿起我的 BanG Dream! POTBELLY FM Rāna 吉他转动查看", "Pick up my BanG Dream! POTBELLY FM Rāna guitar and turn it around")}></button>
        <button class="art-caption" data-open-guitar><span><Icon name="plus" /></span><p><span class="guitar-caption-default">POTBELLY FM RĀNA<br><Fragment set:html={t("靠近一点，它会跟着你。<br>点一下，拿起来", "<span class=\"guitar-follow\">Move closer. It follows you.<br></span>Click to pick it up")} /> <Icon name="northeast" /></span><span class="guitar-caption-portrait">{t("点开吉他", "Open the guitar")} <Icon name="northeast" /></span></p></button>
        <button class="enter" data-place="overview"><span class="round-arrow"><Icon name="horizontal" /></span><span><Fragment set:html={t("进来坐坐<small>把小屋拨开</small>", "Come on in<small>Take a look around</small>")} /></span></button>
        <button class="door door-left" data-place="papers"><span><Icon name="left" /></span><span>{t("几张散页", "Loose pages")}</span></button>
        <button class="door door-right" data-place="music"><span>{t("琴弦之间", "A little jam")}</span><span><Icon name="right" /></span></button>
        <div class="home-bottom"><p><Fragment set:html={t("不用按顺序。<br>随便逛逛，<br>也可以什么都不做。", "Look around.<br>Take your time.")} /></p><p class="welcome"><Fragment set:html={t("在这里，<br><em>待一会儿。</em>", "Stay<br><em>awhile.</em>")} /></p></div>
        <button class="deeper-door" data-place="rethink">{t('小屋深处，还有一些东西', 'There’s more, a little further in')} <span><Icon name="down" /></span></button>
      </section>

      <section class="place papers" data-scene="papers" aria-labelledby="paper-title" inert>
        <div class="place-heading"><span class="eyebrow">{t("散落在这里的几句话", "THINGS I’VE WRITTEN DOWN")}</span><h2 id="paper-title"><Fragment set:html={t("拿起来，<br>翻到另一面。", "Pick a page.<br>Turn it over.")} /></h2><p>{t("拖动纸张，把它挪到你喜欢的位置。", "Move the pages around. Make yourself comfortable.")}</p></div>
        <div class="loose-paper paper-a" data-paper="0" style="--rotation:-10deg" tabindex="0" role="button" aria-label={t("翻看第一张散页：关于命运的随笔", "Turn over the first page: thoughts on fate")} aria-pressed="false">
          <div class="paper-turn"><div class="paper-face paper-front"><span class="paper-index">{t("01 / 写在故事之后", "01 / AFTER A STORY")}</span><p><Fragment set:html={t("至少我今天<br>认真地活过一回，<br><em>这就够了。</em>", "At least today,<br>I lived with intention.<br><em>That’s enough.</em>")} /></p><span class="turn-hint">{t("翻面", "Turn over")} <Icon name="northeast" /></span></div><div class="paper-face paper-back" inert><span class="paper-index">2026.05.17</span><h3>{t("启喻鸟之章", "On fate and fear")}</h3><p><Fragment set:html={t("游戏里的命运、恐惧，<br>和没有那么容易想通的事。", "A game, a sense of fate,<br>and things I’m still figuring out.")} /></p><a href="/blog/posts/2026-05-17-qiyuniao/" target="_blank" rel="noopener noreferrer">{t("去读原文", "Read in Chinese")} <Icon name="northeast" /></a><button type="button" class="turn-back">{t("翻回来", "Turn back")} <Icon name="southwest" /></button></div></div>
        </div>
        <div class="loose-paper paper-b" data-paper="1" style="--rotation:7deg" tabindex="0" role="button" aria-label={t("翻看第二张散页：关于自我修正的随笔", "Turn over the second page: changing my mind")} aria-pressed="false">
          <div class="paper-turn"><div class="paper-face paper-front"><span class="paper-index">{t("02 / 一次改口", "02 / A CHANGE OF MIND")}</span><p><Fragment set:html={t("<s>好记、锋利、适合转发。</s><br>问题是它错了，<br>至少是偷懒。", "<s>Sharp. Catchy. Easy to share.</s><br>The trouble is,<br>it was wrong.<br>Or at least, lazy.")} /></p><span class="turn-hint">{t("翻面", "Turn over")} <Icon name="northeast" /></span></div><div class="paper-face paper-back" inert><span class="paper-index">2026.05.29</span><h3><Fragment set:html={t("世界不是 liar game，<br>是 role game", "Life as a role game,<br>not a liar game")} /></h3><p><Fragment set:html={t("最后也拆掉了<br>自己原先很满意的论证。", "Taking apart an argument<br>I was once quite pleased with.")} /></p><a href="/blog/posts/2026-05-29-liar-game-role-game/" target="_blank" rel="noopener noreferrer">{t("去读原文", "Read in Chinese")} <Icon name="northeast" /></a><button type="button" class="turn-back">{t("翻回来", "Turn back")} <Icon name="southwest" /></button></div></div>
        </div>
        <div class="loose-paper paper-c" data-paper="2" style="--rotation:-3deg" tabindex="0" role="button" aria-label={t("翻看第三张散页：学习笔记", "Turn over the third page: learning notes")} aria-pressed="false">
          <div class="paper-turn"><div class="paper-face paper-front"><span class="paper-index">{t("03 / 给下次的自己", "03 / FOR NEXT TIME")}</span><p><Fragment set:html={t("出错以后，<br><em>还能回来。</em>", "After a mistake,<br><em>there’s a way back.</em>")} /></p><span class="turn-hint">{t("翻面", "Turn over")} <Icon name="northeast" /></span></div><div class="paper-face paper-back" inert><span class="paper-index">2026.05.27</span><h3><Fragment set:html={t("把 GitHub<br>变成肌肉记忆", "GitHub,<br>by muscle memory")} /></h3><p><Fragment set:html={t("第一次留下的笨拙笔记，<br>下次也许刚好能帮上忙。", "Some clumsy first notes.<br>Maybe next time, they’ll help.")} /></p><a href="/blog/posts/2026-05-27-github-muscle-memory/" target="_blank" rel="noopener noreferrer">{t("去读原文", "Read in Chinese")} <Icon name="northeast" /></a><button type="button" class="turn-back">{t("翻回来", "Turn back")} <Icon name="southwest" /></button></div></div>
        </div>
        <nav class="archive-links" aria-label={t('继续阅读', 'Keep reading')}>
          <a href={localizedPath('/blog/', lang)}>{t('所有文章', 'All writing')} <Icon name="northeast" /></a>
          <a href={localizedPath('/projects/', lang)}>{t('项目档案', 'Project archive')} <Icon name="northeast" /></a>
        </nav>
        <button class="paper-reset small-action" type="button">{t("把纸放回去", "Put the pages back")} <Icon name="southwest" /></button>
      </section>

      <section class="place music" data-scene="music" aria-labelledby="music-title" inert>
        <div class="place-heading"><span class="eyebrow">QIU / A LITTLE JAM</span><h2 id="music-title"><Fragment set:html={t("把这一刻，<br><em>弹成自己的。</em>", "Make a little<br><em>noise.</em>")} /></h2><p><Fragment set:html={t("划过六根弦，拧一拧旋钮。<br>好听就多待一会儿。", "Pick a chord. See where it goes.<br>Turn a knob. Stay for another song.")} /></p></div>
        <div class="tone-presets" role="group" aria-label={t("音色起点", "Starting tones")}><span>{t("从一个声音开始", "Start with a sound")}</span><div><button data-tone="clean" aria-pressed="true">{t("清音", "Clean")}</button><button data-tone="gold" aria-pressed="false">{t("暖金", "Gold")}</button><button data-tone="blue" aria-pressed="false">{t("微醺", "Blue")}</button><button data-tone="night" aria-pressed="false">{t("夜游", "After hours")}</button></div><small id="tone-caption" role="status">{t("干净的弦，留一点空气。", "Clean strings. A little room to breathe.")}</small></div>
        <div class="playing-strip"><div class="chord-picker" role="group" aria-label={t("选择和弦", "Choose a chord")}><button data-chord="open" aria-pressed="true">{t("空弦", "Open")}</button><button data-chord="Em" aria-pressed="false">Em</button><button data-chord="G" aria-pressed="false">G</button><button data-chord="C" aria-pressed="false">C</button><button data-chord="D" aria-pressed="false">D</button></div><button id="strum" type="button">{t("扫一下", "Strum")} <span><Icon name="southeast" /></span></button></div>
        <div class="jam-guitar" aria-hidden="false"><img class="jam-photo" src={jamStrings.src} width={jamStrings.width} height={jamStrings.height} alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false"><canvas id="jam-strings" aria-hidden="true"></canvas><div class="string-bed" aria-label={t("六根可弹奏的弦", "Six playable strings")}>{['e', 'B', 'G', 'D', 'A', 'E'].map((note, index) => (
          <button type="button" class="string" data-note={index} aria-label={t(`拨动 ${note} 弦，键盘 ${'ASDFGH'[index]}`, `Pluck the ${note} string, keyboard ${'ASDFGH'[index]}`)}><span>{note}</span><small>{'ASDFGH'[index]}</small></button>
        ))}</div><span class="jam-label" aria-hidden="true">SH-1n · SH-16 · 24¾″</span></div>
        <div class="music-footer">
          <div class="loop-controls" data-state="empty">
            <div class="looper-top"><span>LOOP / 6 SEC</span><span id="loop-layer">{t("00 层", "00 LAYERS")}</span></div>
            <div class="loop-beats" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            <div class="loop-progress" aria-hidden="true"><i></i></div>
            <div class="loop-actions"><button id="loop" type="button">{t("录一段", "Record")} <span><Icon name="record" /></span></button><button id="loop-overdub" type="button" aria-pressed="false" disabled>{t("叠一层", "Overdub")} <Icon name="plus" /></button><button id="loop-clear" type="button" disabled>{t("清空", "Clear")}</button></div>
            <span id="loop-caption" role="status">{t("录 6 秒，循环着接着弹。", "Record six seconds. Play along.")}</span>
          </div>
          <div class="output-strip"><div><button class="sound-local small-action" aria-pressed="false" type="button">{t("打开声音", "Sound on")} <Icon name="northeast" /></button><span id="output-level">−∞ dB</span></div><div class="output-meter" aria-hidden="true"><i></i></div><div class="vu-meter" aria-hidden="true"><svg viewBox="0 0 160 92"><path class="vu-scale" d="M22 70A64 64 0 0 1 138 70"/><path class="vu-hot" d="M112.6 30.4A64 64 0 0 1 138 70"/><g class="vu-ticks"><path d="M27 62l-6-3M36 47l-5-4M48 36l-4-5M62 29l-2-6M80 26v-7M98 29l2-6M112 36l4-5M124 47l5-4M133 62l6-3"/></g><text x="22" y="82">-20</text><text x="54" y="18">-7</text><text x="78" y="14">-3</text><text x="104" y="18">0</text><text x="128" y="82">+3</text><text class="vu-unit" x="80" y="58">VU</text></svg><i class="vu-needle"></i><i class="vu-pivot"></i><span class="vu-lamp"></span></div><label class="master-control"><span>{t("音量", "Volume")}</span><input id="master-volume" type="range" min="0" max="100" value="65" aria-label={t("总音量", "Master volume")}><output for="master-volume">65</output></label></div>
        </div>
        <div class="board-heading"><span>{t("我的小踏板台", "My little pedalboard")}</span><small class="board-hint-desktop">{t("按下开关 · 上下拖动旋钮", "Click to switch · Drag knobs up or down")}</small><small class="board-hint-mobile">{t("左右挪踏板 · 上下调旋钮", "Slide the pedals · Drag knobs to turn")}</small><span class="signal-label">GUITAR <Icon name="right" /> GOLD <Icon name="right" /> BLUE <Icon name="right" /> ECHO <Icon name="right" /> OUT</span></div>
        <div class="pedal-deck" role="group" aria-label={t("效果器踏板台", "Effects pedalboard")}><Pedalboard lang={lang} /></div>
        <div class="board-caption"><span>{t("经典踏板的灵感，自己的声音。", "Classic inspiration. Your own sound.")}</span><span>{t("A S D F G H 拨弦 · 空格扫弦", "A S D F G H to pluck · Space to strum")}</span></div>
      </section>

      <section class="place trace" data-scene="trace" aria-labelledby="trace-title" inert>
        <div class="place-heading"><span class="eyebrow">{t("你也可以留一笔", "A LITTLE SOMETHING FROM YOU")}</span><h2 id="trace-title"><Fragment set:html={t("把一条线，<br>变成一根弦。", "Draw a line.<br>Give it a voice.")} /></h2><p>{t("在空白处画下去。松手后，再拨动它。", "Draw in the empty space. Let go, then pluck.")}</p></div>
        <div class="draw-area" tabindex="0" role="group" aria-label={t("临时画布，拖动画线，松手后触碰线条使它振动", "Temporary canvas. Drag to draw a line, then touch it to hear it ring.")}><span class="drawing-hint">{t("从这里，随手划一下。", "A line can start anywhere.")}</span></div>
        <div class="trace-footer"><p>{t("没有标准形状。", "There’s no right shape.")}<br><span>{t("这一笔，留在这次停留里。", "Just here, for this visit.")}</span></p><div><button class="small-action" id="add-line" type="button">{t("替我起个头", "Give me a starting point")} <Icon name="northeast" /></button><button class="small-action" id="clear-lines" type="button">{t("重新留白", "Start again")} <Icon name="southwest" /></button></div></div>
      </section>
      <MoreRooms lang={lang} />
    </div>
    <div class="daylight" aria-hidden="true"><i class="day-sun"></i><i class="day-blinds"></i><svg class="day-leaves" viewBox="0 0 600 600" preserveAspectRatio="none"><defs><path id="leaf" d="M0 0C20-14 52-12 70 0C52 12 20 14 0 0Z"/></defs><g class="leaf-branch"><path d="M560 0C500 90 470 170 400 240" fill="none" stroke-width="4"/><use href="#leaf" transform="translate(520 60) rotate(130) scale(1.5)"/><use href="#leaf" transform="translate(500 90) rotate(30) scale(1.3)"/><use href="#leaf" transform="translate(470 140) rotate(150) scale(1.8)"/><use href="#leaf" transform="translate(445 170) rotate(40) scale(1.4)"/><use href="#leaf" transform="translate(420 215) rotate(120) scale(1.6)"/><use href="#leaf" transform="translate(402 240) rotate(70) scale(1.2)"/></g><g class="leaf-branch leaf-branch-b"><path d="M600 80C540 160 520 260 470 330" fill="none" stroke-width="3"/><use href="#leaf" transform="translate(570 130) rotate(160) scale(1.4)"/><use href="#leaf" transform="translate(545 180) rotate(20) scale(1.6)"/><use href="#leaf" transform="translate(520 240) rotate(140) scale(1.3)"/><use href="#leaf" transform="translate(495 290) rotate(60) scale(1.5)"/></g></svg><i class="day-grain"></i><i class="day-vignette"></i></div>
    <div class="overview-label" aria-hidden="true"><span>{t("一间没有墙的小屋", "A room without walls")}</span><p>{t("点一个地方，或者直接拖着走。", "Pick a place. Or simply wander.")}</p></div>
  </main>
  <footer class="room-bar">
    <nav class="room-map" aria-label={t('小屋地图', 'Room map')}>
      {mapPlaces.map(([place, zh, en, ariaZh, ariaEn]) => (
        <button class:list={[`map-${place}`, {active: place === 'home'}]} data-place={place} aria-label={t(ariaZh, ariaEn)} aria-current={place === 'home' ? 'location' : undefined}><i></i><span>{t(zh, en)}</span></button>
      ))}
      <svg viewBox="0 0 160 68" aria-hidden="true"><path d="M25 9H135M25 34H135M25 59H135M25 9V59M80 9V59M135 9V59"/></svg>
    </nav>
    <div class="where"><span id="where-name" role="status">{t("小屋中央", "At home")}</span><small id="where-hint">{t("拖动画面漫游 · 滚轮缩放", "Drag to wander · Scroll to zoom")}</small></div>
    <div class="view-tools"><button id="motion" type="button" aria-pressed="false">{t("动态开", "Motion on")}</button><button id="zoom-out" type="button" aria-label={t("退远一些", "Zoom out")}><Icon name="minus" /></button><button id="overview" data-place="overview" type="button" aria-label={t("看看整个小屋", "See the whole room")}><Icon name="overview" /></button><button id="zoom-in" type="button" aria-label={t("靠近一些", "Zoom in")}><Icon name="plus" /></button></div>
  </footer>
  <dialog id="guitar-closeup" aria-labelledby="guitar-title">
    <button id="close-guitar" type="button" aria-label={t("放下吉他，回到小屋", "Put down the guitar and return to the room")}>{t("放回去", "Put it back")} <span><Icon name="southwest" /></span></button>
    <div class="guitar-view">
      <div class="guitar-notes">
        <p class="guitar-kicker">{t("与我一起的东西 / 01", "THINGS I KEEP CLOSE / 01")}</p>
        <h2 id="guitar-title">POTBELLY<br><em>Rāna.</em></h2>
        <p class="guitar-edition">BanG Dream! × ESP<br>SH-1n + SH-16 · REVERSE ZEBRA</p>
        <p id="guitar-status" role="status">{t("酒红色漆面下，是木头本来的纹路。", "Real wood beneath the wine-red finish.")}</p>
        <nav class="guitar-views" aria-label={t("吉他细节位置", "Guitar details")}>
          <button data-guitar-view="body" aria-pressed="true">01 <span>{t("琴身", "Body")}</span></button>
          <button data-guitar-view="neck" aria-pressed="false">02 <span>{t("指板", "Neck")}</span></button>
          <button data-guitar-view="head" aria-pressed="false">03 <span>{t("琴头", "Head")}</span></button>
          <button data-guitar-view="whole" aria-pressed="false"><Icon name="southwest" /> <span>{t("整琴", "Whole")}</span></button>
        </nav>
      </div>
      <div class="guitar-stage" data-view="body"><img id="guitar-photo" src={guitarPhoto.src} width="2400" height="2400" decoding="async" fetchpriority="low" alt={t("模型载入前的 BanG Dream! POTBELLY FM Rāna 官方外形参考", "Official BanG Dream! POTBELLY FM Rāna reference photograph, shown while the model loads")} draggable="false"></div>
    </div>
    <div class="guitar-handling"><ul class="guitar-controls" aria-label={t("怎么看这把琴", "How to look around")}>
      <li class="for-mouse"><svg viewBox="0 0 12 16" aria-hidden="true"><rect x="1" y="1" width="10" height="14" rx="5"/><path d="M1 7h10M6 1v6"/><path class="lit" d="M6 1.2V7H1.2V6A4.8 4.8 0 0 1 6 1.2Z"/></svg><span><b>{t("左键拖动", "Left-drag")}</b>{t("转动", "to turn")}</span></li>
      <li class="for-mouse"><svg viewBox="0 0 12 16" aria-hidden="true"><rect x="1" y="1" width="10" height="14" rx="5"/><path d="M1 7h10M6 1v6"/><path class="lit" d="M6 1.2V7h4.8V6A4.8 4.8 0 0 0 6 1.2Z"/></svg><span><b>{t("右键拖动", "Right-drag")}</b>{t("移动", "to move")}</span></li>
      <li class="for-mouse"><svg viewBox="0 0 12 16" aria-hidden="true"><rect x="1" y="1" width="10" height="14" rx="5"/><rect class="lit" x="5" y="3" width="2" height="4" rx="1"/></svg><span><b>{t("滚轮", "Scroll")}</b>{t("靠近", "to zoom")}</span></li>
      <li class="for-touch"><svg viewBox="0 0 16 16" aria-hidden="true"><circle class="lit" cx="8" cy="8" r="3"/></svg><span><b>{t("单指拖动", "One finger")}</b>{t("转动", "turns")}</span></li>
