      <path class="centaur-hatch" d="M30 36.5C38 34.6 50 35.4 60 35M27 47.5C34 49.6 46 49.2 56 48.2M66 22Q69 24 72 21.6M66.6 31Q69 32.4 71.6 30.6"/>
    </g>
    <text x="47" y="88" class="gold-title">CENTAUR</text>
