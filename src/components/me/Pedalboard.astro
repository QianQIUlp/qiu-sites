      <path d="M64 44C67 49 70 52 73 53.5L76 54C78 52.5 80 50.5 82 49.5L83.5 51.5C81.5 53.5 80 56 78 58C74.5 59 70 57.5 66 55C63.5 53 61.5 50 61 47Z"/>
      <path d="M21 39C22 33 28 30.5 36 31C44 31.5 52 32.5 60 32C66 31.6 71 33.5 72.6 38C74 42.5 72.5 47.5 68.5 50C64.5 52.5 59 51.5 53 51.8C46 52.2 40 53.6 34 53C28.5 52.4 23.5 50 21.6 46C20.8 43.6 20.6 41.2 21 39Z"/>
