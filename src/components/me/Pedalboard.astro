---
import type { Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (zh: string, en: string) => lang === 'en' ? en : zh;
---
<div class="patch-cable cable-one" aria-hidden="true"></div><div class="patch-cable cable-two" aria-hidden="true"></div>
<article class="pedal pedal-gold" data-effect="gold" data-on="false" aria-label={t("金色过载，半人马灵感", "Gold overdrive, inspired by the Centaur")}>
 <i class="screw screw-tl" aria-hidden="true"></i><i class="screw screw-tr" aria-hidden="true"></i><i class="screw screw-bl" aria-hidden="true"></i><i class="screw screw-br" aria-hidden="true"></i><i class="jack jack-left" aria-hidden="true"></i><i class="jack jack-right" aria-hidden="true"></i>
 <div class="pedal-dials"><label class="dial" title={t("金色过载 Gain：上下拖动、滚轮或方向键调节", "Gold overdrive Gain: drag vertically, scroll, or use arrow keys")}><span class="dial-label">GAIN</span><span class="dial-control" style="--angle:-48.599999999999994deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="goldDrive" aria-label={t("金色过载 Gain", "Gold overdrive Gain")} min="0" max="100" step="1" value="32"></span><output>3.2</output></label><label class="dial" title={t("金色过载 Treble：上下拖动、滚轮或方向键调节", "Gold overdrive Treble: drag vertically, scroll, or use arrow keys")}><span class="dial-label">TREBLE</span><span class="dial-control" style="--angle:13.5deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="goldTone" aria-label={t("金色过载 Treble", "Gold overdrive Treble")} min="0" max="100" step="1" value="55"></span><output>5.5</output></label><label class="dial" title={t("金色过载 Output：上下拖动、滚轮或方向键调节", "Gold overdrive Output: drag vertically, scroll, or use arrow keys")}><span class="dial-label">OUTPUT</span><span class="dial-control" style="--angle:0deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="goldLevel" aria-label={t("金色过载 Output", "Gold overdrive Output")} min="0" max="100" step="1" value="50"></span><output>5.0</output></label></div>
 <div class="gold-art" aria-hidden="true"><svg viewBox="0 0 140 70"><path d="M16 57 30 43l24 2 11-13 14-4 8-16 8-7 6 5-5 12-10 11 9 8 15 6 10-5M31 44l-3 16m26-15 1 16m27-28-1 20 14 7M66 32 62 22l-10-4M90 20l21-2 17-10m-17 10 16 8M113 3q17 12 0 30M15 60h90"/><circle cx="99" cy="9" r="3"/></svg><strong>CENTAUR</strong><span>GOLD OVERDRIVE</span></div>
 <button class="footswitch" data-pedal="gold" aria-pressed="false" aria-label={t("金色过载开关", "Gold overdrive switch")}><i class="led" aria-hidden="true"></i><span class="metal-switch" aria-hidden="true"></span><span class="pedal-state">{t("旁通", "BYPASS")}</span></button>
 <span class="pedal-edition">KLON-INSPIRED / QIU'S STUDY</span>
</article>
<article class="pedal pedal-blue" data-effect="blue" data-on="false" aria-label={t("蓝色过载，Blues Driver 灵感", "Blue overdrive, inspired by the Blues Driver")}>
 <i class="jack jack-left" aria-hidden="true"></i><i class="jack jack-right" aria-hidden="true"></i><i class="screw screw-tl" aria-hidden="true"></i><i class="screw screw-tr" aria-hidden="true"></i>
 <div class="pedal-dials"><label class="dial" title={t("蓝色过载 Level：上下拖动、滚轮或方向键调节", "Blue overdrive Level: drag vertically, scroll, or use arrow keys")}><span class="dial-label">LEVEL</span><span class="dial-control" style="--angle:0deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="blueLevel" aria-label={t("蓝色过载 Level", "Blue overdrive Level")} min="0" max="100" step="1" value="50"></span><output>5.0</output></label><label class="dial" title={t("蓝色过载 Tone：上下拖动、滚轮或方向键调节", "Blue overdrive Tone: drag vertically, scroll, or use arrow keys")}><span class="dial-label">TONE</span><span class="dial-control" style="--angle:0deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="blueTone" aria-label={t("蓝色过载 Tone", "Blue overdrive Tone")} min="0" max="100" step="1" value="50"></span><output>5.0</output></label><label class="dial" title={t("蓝色过载 Gain：上下拖动、滚轮或方向键调节", "Blue overdrive Gain: drag vertically, scroll, or use arrow keys")}><span class="dial-label">GAIN</span><span class="dial-control" style="--angle:-21.60000000000001deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="blueDrive" aria-label={t("蓝色过载 Gain", "Blue overdrive Gain")} min="0" max="100" step="1" value="42"></span><output>4.2</output></label></div>
 <div class="blue-name"><span>Blues Driver</span><strong>BD-2</strong><small>OVERDRIVE</small></div>
 <button class="footswitch blue-tread" data-pedal="blue" aria-pressed="false" aria-label={t("蓝色过载开关", "Blue overdrive switch")}><i class="led" aria-hidden="true"></i><span class="rubber-pad" aria-hidden="true"><b>BOSS</b></span><span class="pedal-state">{t("旁通", "BYPASS")}</span></button>
 <i class="thumbscrew" aria-hidden="true"></i>
</article>
<article class="pedal pedal-echo" data-effect="echo" data-on="false" aria-label={t("夜游回声", "After Hours echo")}>
 <i class="screw screw-tl" aria-hidden="true"></i><i class="screw screw-tr" aria-hidden="true"></i><i class="screw screw-bl" aria-hidden="true"></i><i class="screw screw-br" aria-hidden="true"></i><i class="jack jack-left" aria-hidden="true"></i><i class="jack jack-right" aria-hidden="true"></i>
 <div class="echo-brand"><span>AFTER HOURS</span><small>{t("磁带般的回声", "TAPE-LIKE ECHO")}</small></div>
 <div class="pedal-dials"><label class="dial" title={t("回声 Time：上下拖动、滚轮或方向键调节", "Echo Time: drag vertically, scroll, or use arrow keys")}><span class="dial-label">TIME</span><span class="dial-control" style="--angle:-7.5deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="echoTime" aria-label={t("回声 Time", "Echo Time")} min="80" max="800" step="10" value="420"></span><output>420 ms</output></label><label class="dial" title={t("回声 Repeat：上下拖动、滚轮或方向键调节", "Echo Repeat: drag vertically, scroll, or use arrow keys")}><span class="dial-label">REPEAT</span><span class="dial-control" style="--angle:-7.5deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="echoFeedback" aria-label={t("回声 Repeat", "Echo Repeat")} min="0" max="72" step="1" value="34"></span><output>3.4</output></label><label class="dial" title={t("回声 Mix：上下拖动、滚轮或方向键调节", "Echo Mix: drag vertically, scroll, or use arrow keys")}><span class="dial-label">MIX</span><span class="dial-control" style="--angle:-59.39999999999999deg"><span class="dial-ticks" aria-hidden="true"></span><span class="knob" aria-hidden="true"><i></i></span><input type="range" data-param="echoMix" aria-label={t("回声 Mix", "Echo Mix")} min="0" max="100" step="1" value="28"></span><output>2.8</output></label></div>
 <div class="echo-display"><span>DELAY</span><strong id="echo-readout">420</strong><small>ms</small><i aria-hidden="true">I II III IV V</i><span class="tape" aria-hidden="true"><b class="reel"></b><b class="tape-run"></b><b class="reel"></b></span></div>
 <button class="footswitch" data-pedal="echo" aria-pressed="false" aria-label={t("回声开关", "Echo switch")}><i class="led" aria-hidden="true"></i><span class="metal-switch" aria-hidden="true"></span><span class="pedal-state">{t("旁通", "BYPASS")}</span></button>
 <span class="pedal-edition">LET THE NOTE STAY A LITTLE</span>
</article>
