    <g transform="translate(47 98)" class="led"><circle r="2.3" fill="#1c1812"/><circle r="1.6" class="led-lens"/><circle cx="-.5" cy="-.55" r=".45" fill="#fff" opacity=".6"/></g>
    <Fragment set:html={stomp(47, 108.2)} />
    <use href="#pg-screw" x="5" y="5"/><use href="#pg-screw" x="89" y="5" transform="rotate(30 89 5)"/><use href="#pg-screw" x="5" y="114" transform="rotate(80 5 114)"/><use href="#pg-screw" x="89" y="114" transform="rotate(10 89 114)"/>
  </svg>
  <PedalKnob kind="klon" param="goldDrive" label="GAIN" aria={t("金色过载 Gain", "Gold overdrive Gain")} hint={hint('GAIN')} value={32} x={20} y={19.5} size={27}/>
